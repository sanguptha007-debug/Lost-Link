# ==============================================================================
# LostLink — Environment Variables Template (.env.example)
# ==============================================================================
# Instructions:
# 1. Copy this file to `.env`:
#      cp .env.example .env   (Linux/macOS)
#      copy .env.example .env (Windows PowerShell/CMD)
# 2. Fill in your actual credentials.
# 3. NEVER commit your real `.env` file or private keys to source control!
# ==============================================================================


# ==============================================================================
# 1. SERVER CONFIGURATION [PRIVATE / BACKEND ONLY]
# ==============================================================================
PORT=3000
NODE_ENV=development


# ==============================================================================
# 2. AI PROVIDER CONFIGURATION [PRIVATE / BACKEND ONLY - SECRETS]
# ==============================================================================
# AI provider choice: 'gemini' (default) or 'groq'
AI_PROVIDER=gemini

# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.7-flash

# Groq API (Optional fallback provider)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile


# ==============================================================================
# 3. FIREBASE ADMIN SDK [PRIVATE / BACKEND ONLY - HIGH SECURITY SECRETS]
# Used exclusively by the Express backend (Firestore & Admin verification)
# ==============================================================================
# OPTION A (Recommended): Path to service account JSON file placed in project root
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json

# OPTION B: Individual environment variables (used if Option A path is omitted)
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-firebase-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"

# Firebase Admin Storage Bucket (Optional)
FIREBASE_STORAGE_BUCKET=your-firebase-project-id.firebasestorage.app


# ==============================================================================
# 4. SUPABASE STORAGE [PRIVATE / BACKEND ONLY - HIGH SECURITY SECRETS]
# Used exclusively on the server for item photos (kept strictly backend-side)
# ==============================================================================
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=your_supabase_service_role_or_secret_key_here
SUPABASE_STORAGE_BUCKET=item-photos


# ==============================================================================
# 5. FIREBASE CLIENT CONFIG [SAFE / PUBLIC FRONTEND CONFIGURATION]
# Safe to expose to the browser; sent to the frontend via /api/config/firebase
# ==============================================================================
FIREBASE_CLIENT_API_KEY=AIzaSyYourClientApiKeyHere
FIREBASE_CLIENT_AUTH_DOMAIN=your-firebase-project-id.firebaseapp.com
FIREBASE_CLIENT_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_STORAGE_BUCKET=your-firebase-project-id.firebasestorage.app
FIREBASE_CLIENT_MESSAGING_SENDER_ID=123456789012
FIREBASE_CLIENT_APP_ID=1:123456789012:web:abcdef1234567890
